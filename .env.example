# ---- Public (safe for the browser) ----
# On Verdent hosting these are injected automatically as VITE_* variables and
# mapped by next.config.ts — only set them here for non-Verdent deployments.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: Verdent OAuth initiate URL for managed Google sign-in (injected on Verdent)
NEXT_PUBLIC_VERDENT_OAUTH_INITIATE_URL=

# ---- Server-only (never expose to the browser) ----
# Supabase service credentials (server-side only)
SUPABASE_SECRET_KEY=

# Anthropic Claude — used by /api/itinerary/generate
CLAUDE_API_KEY=

# Transactional email provider (Resend-compatible adapter)
EMAIL_API_KEY=
EMAIL_FROM="Sri Lankan Guru <info@srilankanguru.com>"

# Optional: shared secret required by the PDF endpoint when exposed publicly
PDF_SERVICE_KEY=
